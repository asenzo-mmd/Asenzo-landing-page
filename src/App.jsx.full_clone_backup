        inset: 0,
        zIndex: 1000,
        backgroundColor: "rgba(0, 0, 0, 0.75)",
        backdropFilter: "blur(12px)",
        WebkitBackdropFilter: "blur(12px)",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        padding: 20
      }}
      onClick={onClose}
    >
      <div
        style={{
          width: "100%",
          maxWidth: 520,
          backgroundColor: "#111113",
          border: "1px solid rgba(255, 98, 7, 0.35)",
          borderRadius: 20,
          padding: 36,
          boxShadow: "0 25px 60px rgba(0, 0, 0, 0.8), 0 0 40px rgba(255, 98, 7, 0.15)",
          color: "#ffffff",
          position: "relative"
        }}
        onClick={(e) => e.stopPropagation()}
      >
        {/* Close button */}
        <button
          onClick={onClose}
          style={{
            position: "absolute",
            top: 20,
            right: 20,
            width: 32,
            height: 32,
            borderRadius: "50%",
            backgroundColor: "rgba(255, 255, 255, 0.08)",
            border: "none",
            color: "#ffffff",
            fontSize: 16,
            cursor: "pointer",
            display: "flex",
            alignItems: "center",
            justifyContent: "center"
          }}
        >
          ✕
        </button>

        {submitted ? (
          <div style={{ textAlign: "center", padding: "20px 0" }}>
            <div
              style={{
                width: 56,
                height: 56,
                borderRadius: "50%",
                background: "linear-gradient(135deg, #ff6207 0%, #27c93f 100%)",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                margin: "0 auto 20px auto",
                fontSize: 24
              }}
            >
              ✓
            </div>
            <h3 style={{ fontSize: 24, fontWeight: 700, marginBottom: 12 }}>
              Session Requested!
            </h3>
            <p style={{ fontSize: 14.5, color: "#8e8e93", lineHeight: 1.6, marginBottom: 28 }}>
              Thank you, {formData.name || "there"}. We've received your diagnostic details for {formData.company || "your team"}. Our principal solutions architect will reach out within 2 hours.
            </p>
            <button
              onClick={onClose}
              className="btn-accretion-orange"
              style={{ width: "100%" }}
            >
              Back to ASENZO
            </button>
          </div>
        ) : (
          <div>
            <div style={{ display: "inline-flex", marginBottom: 12 }}>
              <div className="badge-pill-dark">
                <span style={{ color: "#ff6207" }}>✦</span>
                <span>STEP {step} OF 3</span>
              </div>
            </div>

            <h3
              style={{
                fontFamily: "'Switzer', 'Inter', sans-serif",
                fontSize: 24,
                fontWeight: 700,
                marginBottom: 8
              }}
            >
              Book an ASENZO Architecture Call
            </h3>
            <p style={{ fontSize: 14, color: "#8e8e93", marginBottom: 24 }}>
              Diagnose bottlenecks, explore integrations, and test custom workflow automations.
            </p>

            {step === 1 && (
              <div>
                <label style={{ display: "block", fontSize: 13, fontWeight: 600, color: "#d1d1d6", marginBottom: 8 }}>
                  What is your team size?
                </label>
                <div style={{ display: "grid", gridTemplateColumns: "repeat(2, 1fr)", gap: 10, marginBottom: 24 }}>
                  {["1-10 members", "10-50 members", "50-200 members", "200+ enterprise"].map((opt) => (
                    <button
                      key={opt}
                      type="button"
                      onClick={() => setFormData({ ...formData, teamSize: opt })}
                      style={{
                        padding: "12px",
                        borderRadius: 10,
                        backgroundColor: formData.teamSize === opt ? "rgba(255, 98, 7, 0.15)" : "rgba(255, 255, 255, 0.04)",
                        border: formData.teamSize === opt ? "1px solid #ff6207" : "1px solid rgba(255, 255, 255, 0.08)",
                        color: formData.teamSize === opt ? "#ffffff" : "#8e8e93",
                        fontSize: 13,
                        fontWeight: 500,
                        cursor: "pointer"
                      }}
                    >
                      {opt}
                    </button>
                  ))}
                </div>
                <button
                  type="button"
                  onClick={() => setStep(2)}
                  className="btn-accretion-orange"
                  style={{ width: "100%" }}
                >
                  Continue →
                </button>
              </div>
            )}

            {step === 2 && (
              <div>
                <label style={{ display: "block", fontSize: 13, fontWeight: 600, color: "#d1d1d6", marginBottom: 8 }}>
                  What is your primary operational objective?
                </label>
                <div style={{ display: "flex", flexDirection: "column", gap: 10, marginBottom: 24 }}>
                  {[
                    "Tool sprawl & fragmented team context",
                    "Slow execution on cross-functional handoffs",
                    "Need automated reporting & analytics",
                    "Scaling acquisition and client onboarding"
                  ].map((opt) => (
                    <button
                      key={opt}
                      type="button"
                      onClick={() => setFormData({ ...formData, challenge: opt })}
                      style={{
                        padding: "12px 16px",
                        borderRadius: 10,
                        textAlign: "left",
                        backgroundColor: formData.challenge === opt ? "rgba(255, 98, 7, 0.15)" : "rgba(255, 255, 255, 0.04)",
                        border: formData.challenge === opt ? "1px solid #ff6207" : "1px solid rgba(255, 255, 255, 0.08)",
                        color: formData.challenge === opt ? "#ffffff" : "#8e8e93",
                        fontSize: 13,
                        fontWeight: 500,
                        cursor: "pointer"
                      }}
                    >
                      {opt}
                    </button>
                  ))}
                </div>
                <div style={{ display: "flex", gap: 10 }}>
                  <button
                    type="button"
                    onClick={() => setStep(1)}
                    style={{
                      height: 44,
                      padding: "0 20px",
                      borderRadius: 9999,
                      backgroundColor: "rgba(255, 255, 255, 0.06)",
                      border: "none",
                      color: "#ffffff",
                      fontSize: 13,
                      cursor: "pointer"
                    }}
                  >
                    Back
                  </button>
                  <button
                    type="button"
                    onClick={() => setStep(3)}
                    className="btn-accretion-orange"
                    style={{ flex: 1 }}
                  >
                    Continue →
                  </button>
                </div>
              </div>
            )}

            {step === 3 && (
              <form onSubmit={handleFinish}>
                <div style={{ display: "flex", flexDirection: "column", gap: 14, marginBottom: 24 }}>
                  <div>
                    <label style={{ display: "block", fontSize: 12.5, color: "#a1a1a6", marginBottom: 6 }}>
                      Full Name
                    </label>
                    <input
                      type="text"
                      required
                      placeholder="Jane Doe"
                      value={formData.name}
                      onChange={(e) => setFormData({ ...formData, name: e.target.value })}
                      style={{
                        width: "100%",
                        height: 42,
                        borderRadius: 8,
                        backgroundColor: "rgba(255, 255, 255, 0.04)",
                        border: "1px solid rgba(255, 255, 255, 0.1)",
                        padding: "0 14px",
                        color: "#ffffff",
                        fontSize: 14,
                        outline: "none"
                      }}
                    />
                  </div>
                  <div>
                    <label style={{ display: "block", fontSize: 12.5, color: "#a1a1a6", marginBottom: 6 }}>
                      Work Email
                    </label>
                    <input
                      type="email"
                      required
                      placeholder="jane@company.com"
                      value={formData.email}
                      onChange={(e) => setFormData({ ...formData, email: e.target.value })}
                      style={{
                        width: "100%",
                        height: 42,
                        borderRadius: 8,
                        backgroundColor: "rgba(255, 255, 255, 0.04)",
                        border: "1px solid rgba(255, 255, 255, 0.1)",
                        padding: "0 14px",
                        color: "#ffffff",
                        fontSize: 14,
                        outline: "none"
                      }}
                    />
                  </div>
                  <div>
                    <label style={{ display: "block", fontSize: 12.5, color: "#a1a1a6", marginBottom: 6 }}>
                      Company Name
                    </label>
                    <input
                      type="text"
                      required
                      placeholder="Acme Corp"
                      value={formData.company}
                      onChange={(e) => setFormData({ ...formData, company: e.target.value })}
                      style={{
                        width: "100%",
                        height: 42,
                        borderRadius: 8,
                        backgroundColor: "rgba(255, 255, 255, 0.04)",
                        border: "1px solid rgba(255, 255, 255, 0.1)",
                        padding: "0 14px",
                        color: "#ffffff",
                        fontSize: 14,
                        outline: "none"
                      }}
                    />
                  </div>
                </div>

                <div style={{ display: "flex", gap: 10 }}>
                  <button
                    type="button"
                    onClick={() => setStep(2)}
                    style={{
                      height: 44,
                      padding: "0 20px",
                      borderRadius: 9999,
                      backgroundColor: "rgba(255, 255, 255, 0.06)",
                      border: "none",
                      color: "#ffffff",
                      fontSize: 13,
                      cursor: "pointer"
                    }}
                  >
                    Back
                  </button>
                  <button
                    type="submit"
                    className="btn-accretion-orange"
                    style={{ flex: 1 }}
                  >
                    Confirm & Schedule Call
                  </button>
                </div>
              </form>
            )}
          </div>
        )}
      </div>
    </div>
  );
}
