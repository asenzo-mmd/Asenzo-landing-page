        display: 'inline-block',
        fontSize: 'clamp(80px, 18.5vw, 280px)',
        fontWeight: 700,
        letterSpacing: '-0.05em',
        lineHeight: 0.85,
        width: '100%',
        background: 'linear-gradient(180deg, #282828 0%, #0F0F0F 65%, #000000 100%)',
        WebkitBackgroundClip: 'text',
        WebkitTextFillColor: 'transparent'
      }}>
        Asenzo®
      </span>
