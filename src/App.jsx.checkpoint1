    </div>

    {/* Large Editorial Asenzo® Watermark with Top Spacing & Bottom Vertical Fade */}
    <div style={{
      width: '100%',
      marginTop: '80px',
      marginBottom: '-20px',
      textAlign: 'center',
      userSelect: 'none',
      overflow: 'hidden'
