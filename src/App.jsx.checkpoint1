// Problem Leak Section
const ProblemLeakSection = () => (
  <section style={{ backgroundColor: '#000000', padding: '80px 0', borderBottom: '1px solid #202020' }}>
    <div className="mobile-container" style={{ maxWidth: '1280px', margin: '0 auto', padding: '0 20px' }}>
