          .roi-apple-input:focus-within {
            background-color: rgba(255,255,255,0.05) !important;
            border-color: rgba(255,255,255,0.15) !important;
          }
          @media (max-width: 900px) {
            .roi-glass-container {
              grid-template-columns: 1fr !important;
