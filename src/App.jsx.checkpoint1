// 7. Premium Apple-Style ROI Calculator
const ClearROICalculator = ({ onAssessmentClick }) => {
  const [clientValue, setClientValue] = useState(3000);
  const [newClients, setNewClients] = useState(5);

  const monthlyRevenue = clientValue * newClients;
  const yearlyRevenue = monthlyRevenue * 12;

  return (
    <section style={{
      backgroundColor: '#000000',
      padding: '100px 24px',
      position: 'relative',
      overflow: 'hidden'
    }}>
      {/* Immersive cinematic background glow removed per user request */}

      <div style={{ maxWidth: '1000px', margin: '0 auto', position: 'relative', zIndex: 2 }}>

        {/* Header exact match to AIBenefitsSection */}
        <div style={{ textAlign: 'center', marginBottom: '48px', display: 'flex', flexDirection: 'column', alignItems: 'center' }}>
          <div style={{
            display: 'inline-flex',
            backgroundColor: '#0A0A0C',
            border: '1px solid rgba(255,255,255,0.08)',
            borderRadius: '6px',
            padding: '6px 14px',
            fontSize: '11px',
            color: '#FFFFFF',
            fontWeight: 500,
            marginBottom: '24px'
          }}>
            Benefits
          </div>
          <h2 style={{ fontSize: 'clamp(32px, 4vw, 48px)', fontWeight: 500, lineHeight: 1.15, color: '#FFFFFF', marginBottom: '16px', letterSpacing: '-0.02em', maxWidth: '800px', margin: '0 auto 16px auto' }}>
            The Key Benefits of AI<br />for Your Business Growth
          </h2>
          <p style={{ fontSize: '15px', color: '#8A8A8A', maxWidth: '640px', margin: '0 auto', lineHeight: 1.55 }}>
            Discover how AI automation enhances efficiency, reduces costs, and drives<br />business growth with smarter, faster processes.
          </p>
        </div>

        <div className="roi-glass-container" style={{
          backgroundColor: 'rgba(12, 12, 14, 0.65)',
          backdropFilter: 'blur(32px)',
          WebkitBackdropFilter: 'blur(32px)',
          border: '1px solid rgba(255, 255, 255, 0.08)',
          borderRadius: '32px',
          overflow: 'hidden',
          display: 'grid',
          gridTemplateColumns: '1fr 1fr',
          boxShadow: '0 30px 80px -20px rgba(0,0,0, 0.8), inset 0 1px 1px rgba(255,255,255,0.05)',
        }}>

          {/* Controls Side */}
          <div style={{ padding: '40px 32px', display: 'flex', flexDirection: 'column', gap: '32px' }}>

            {/* LTV Input */}
            <div>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '20px' }}>
                <label style={{ fontSize: '15px', color: '#8A8A8A', fontWeight: 500, letterSpacing: '-0.01em' }}>Average Client LTV</label>
              </div>
              <div style={{
                position: 'relative',
                backgroundColor: 'rgba(255,255,255,0.03)',
                border: '1px solid rgba(255, 255, 255, 0.05)',
                boxShadow: 'inset 0 2px 4px rgba(0,0,0,0.2)',
                borderRadius: '16px',
                padding: '20px 24px',
                display: 'flex',
                alignItems: 'center',
                gap: '12px',
                transition: 'border-color 0.3s, background-color 0.3s',
              }} className="roi-apple-input">
                <span style={{ fontSize: '24px', color: '#555', fontWeight: 500 }}>$</span>
                <input
                  type="text"
                  value={clientValue.toLocaleString()}
                  onChange={(e) => {
                    const val = Number(e.target.value.replace(/[^0-9]/g, ''));
                    if (!isNaN(val) && val <= 1000000) setClientValue(val);
                  }}
                  style={{
                    backgroundColor: 'transparent',
                    border: 'none',
                    outline: 'none',
                    color: '#FFFFFF',
                    fontSize: '28px',
                    fontWeight: 500,
                    width: '100%',
                    fontFamily: 'inherit',
                    letterSpacing: '-0.02em',
                    fontVariantNumeric: 'tabular-nums'
                  }}
                />
              </div>
            </div>

            {/* Scale Slider */}
            <div>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'baseline', marginBottom: '16px' }}>
                <span style={{ fontSize: '15px', color: '#8A8A8A', fontWeight: 500, letterSpacing: '-0.01em' }}>New Clients / Month</span>
                <span style={{ fontSize: '24px', color: '#FFFFFF', fontWeight: 500, fontVariantNumeric: 'tabular-nums' }}>
                  {newClients}
                </span>
